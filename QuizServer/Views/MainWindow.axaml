<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuizServer.ViewModels"
        xmlns:v="using:QuizServer.Views"
        xmlns:views="clr-namespace:QuizServer.Views"
        xmlns:viewModels="clr-namespace:QuizServer.ViewModels"
        x:Class="QuizServer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QuizNet Console" Width="1200" Height="750">

    <ContentControl Content="{Binding Navigation.CurrentViewModel}" />
</Window>